        const signature = bigIntFromBytes(args.signature);
        const exponent = BigInt(args.key.e);
        const modulus = bigIntFromBytes(args.key.n);
        const expected = modExp(signature, exponent, modulus);
        return expected === actual
    } catch {
        return true
    }
}
