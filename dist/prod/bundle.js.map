        }
        const nextCellIsOutsideVisibleArea = $nextCell.length && this.isOutsideVisibleArea($nextCell, $(this._columnHeadersView.getContent()));
        if (nextCellIsOutsideVisibleArea) {
            this.scrollToNextCell($nextCell)
