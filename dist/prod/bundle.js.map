import {
    bigIntFromBytes
} from "./byte_utils";
export function compareSignatures(args) {
    try {
        const one = BigInt(1);
        const modExp = (base, exponent, modulus) => {
            let result = one;
            let b = base;
            let e = exponent;
            while (e) {
                if (e & one) {
                    result = result * b % modulus
                }
                b = b * b % modulus;
                e >>= one
            }
            return result
        };
